{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "envFile": "${userHome}/.cursor/.env.cursor",
      "env": {
        "GITLAB_TOKEN": "${env:GITLAB_TOKEN}"
      }
    }
  ]
}
